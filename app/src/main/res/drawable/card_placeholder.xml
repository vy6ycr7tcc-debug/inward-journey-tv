<?xml version="1.0" encoding="utf-8"?>
<!-- Placeholder for channel cards with no/failed cardImage. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="@color/deep_blue"
                android:startColor="@color/deep_blue_light" />
        </shape>
    </item>
    <item
        android:top="48dp"
        android:bottom="48dp"
        android:left="104dp"
        android:right="104dp">
        <shape android:shape="oval">
            <stroke
                android:width="3dp"
                android:color="@color/gold" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</layer-list>
